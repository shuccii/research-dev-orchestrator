{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Dev Orchestrator task result v0.2",
  "type": "object",
  "required": ["schema_version", "run_id", "task_id", "parent_task_id", "started_at", "ended_at", "status", "summary", "artifacts", "evidence", "risks", "next_actions", "approval", "verification"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "parent_task_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "worker_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["completed", "needs_revision", "blocked", "awaiting_approval", "failed"]},
    "blocked_reason": {"enum": ["budget_exceeded", "budget_unobservable", "external_dependency", "resource_unavailable"]},
    "summary": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "approval": {"type": "object", "required": ["required", "status", "approved_by", "operation_succeeded"], "properties": {
      "required": {"type": "boolean"}, "status": {"enum": ["not_required", "pending", "approved"]},
      "approved_by": {"enum": [null, "user"]}, "operation_succeeded": {"type": "boolean"}
    }, "additionalProperties": false},
    "verification": {
      "type": "object", "required": ["required_checks", "checks", "validity_review"],
      "properties": {
        "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}},
        "checks": {"type": "array", "items": {
          "type": "object", "required": ["check_id", "type", "result", "observed_by", "evidence_refs"],
          "properties": {
            "check_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
            "type": {"enum": ["command", "schema", "hash", "file_exists", "render", "semantic_review"]},
            "result": {"enum": ["passed", "failed", "not_run"]},
            "observed_by": {"enum": ["harness", "worker", "reviewer"]},
            "observer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
            "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "command": {"type": "string"}, "exit_code": {"type": "integer"}
          }, "additionalProperties": false
        }},
        "validity_review": {"type": "object", "required": ["required", "status", "reviewer_id"], "properties": {
          "required": {"type": "boolean"}, "status": {"enum": ["passed", "failed", "not_run"]},
          "reviewer_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
        }, "additionalProperties": false}
      }, "additionalProperties": false
    }
  }, "additionalProperties": false
}
